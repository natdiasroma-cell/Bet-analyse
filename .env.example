# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=bet_user
DB_PASSWORD=secure_password
DB_NAME=bet_analyse

# Redis
REDIS_URL=redis://:redis_secure@localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# API Keys - Data Sources
FOOTYSTATS_API_KEY=your_footystats_key
SOFASCORE_API_KEY=your_sofascore_key
FLASHSCORE_API_KEY=your_flashscore_key

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@bet-analyse.com

# Node Environment
NODE_ENV=development
PORT=3000

# Frontend
REACT_APP_API_URL=http://localhost:3000
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_your_key_here

# Sentry (Error Tracking)
SENTRY_DSN=

# Analytics
GOOGLE_ANALYTICS_ID=
